# Copy this file to .env and fill values locally.
# Never commit real credentials or service-role keys.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
# Server-only secret. Never prefix with VITE_ and never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only Google AI Studio key used by the assistant and agents.
GEMINI_API_KEY=
